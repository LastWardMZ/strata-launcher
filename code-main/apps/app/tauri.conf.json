{
	"$schema": "https://schema.tauri.app/config/2",
	"build": {
		"beforeDevCommand": "pnpm -w i18n:coverage && pnpm turbo run dev --filter=@modrinth/app-frontend",
		"beforeBuildCommand": "pnpm turbo run build --filter=@modrinth/app-frontend",
		"frontendDist": "../app-frontend/dist",
		"devUrl": "http://localhost:1420"
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"category": "Game",
		"copyright": "",
		"targets": [
			"nsis"
		],
		"externalBin": [],
		"icon": [
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico",
				"headerImage": "icons/installer-header.bmp",
				"sidebarImage": "icons/installer-sidebar.bmp"
			}
		},
		"longDescription": "",
		"macOS": {
			"entitlements": "App.entitlements",
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null,
			"dmg": {
				"background": "./dmg/dmg-background.png",
				"windowSize": {
					"width": 661,
					"height": 432
				},
				"appPosition": {
					"x": 188,
					"y": 212
				},
				"applicationFolderPosition": {
					"x": 475,
					"y": 212
				}
			}
		},
		"shortDescription": "Minecraft Java y servidores personales",
		"linux": {
			"deb": {
				"depends": []
			}
		},
		"publisher": "Strata"
	},
	"productName": "Strata Minecraft",
	"version": "../app-frontend/package.json",
	"mainBinaryName": "Strata",
	"identifier": "com.strata.minecraft.local",
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0Nzg4M0MzNTM0Q0E0MjEKUldRaHBFeFR3NE40WklSZTl4WG9BU2FvTUVkdXBJV0dwQWtJQTFULzNFT3ArT3NJdGRzVDM3cDMK",
			"endpoints": [
				"https://github.com/LastWardMZ/strata-launcher/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		},
		"deep-link": {
			"desktop": {
				"schemes": [
					"strata-local"
				]
			},
			"mobile": []
		}
	},
	"app": {
		"withGlobalTauri": false,
		"macOSPrivateApi": true,
		"windows": [
			{
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"fullscreen": false,
				"height": 800,
				"resizable": true,
				"title": "Strata",
				"label": "main",
				"width": 1280,
				"minHeight": 700,
				"minWidth": 1100,
				"visible": false,
				"zoomHotkeysEnabled": false,
				"decorations": false
			}
		],
		"security": {
			"assetProtocol": {
				"scope": [
					"$APPDATA/caches/icons/*",
					"$APPCONFIG/caches/icons/*",
					"$CONFIG/caches/icons/*",
					"$APPDATA/profiles/*/saves/*/icon.png",
					"$APPCONFIG/profiles/*/saves/*/icon.png",
					"$CONFIG/profiles/*/saves/*/icon.png"
				],
				"enable": true
			},
			"capabilities": [
				"core",
				"plugins",
				"updater"
			],
			"csp": {
				"default-src": "'self' customprotocol: asset:",
				"connect-src": "ipc: http://ipc.localhost https://modrinth.com https://*.modrinth.com https://api.mclo.gs http://textures.minecraft.net https://textures.minecraft.net https://fill.papermc.io https://api.purpurmc.org 'self' data: blob:",
				"font-src": [
					"https://cdn.modrinth.com/fonts/"
				],
				"img-src": "https: 'unsafe-inline' 'self' asset: http://asset.localhost http://textures.minecraft.net blob: data:",
				"style-src": "'unsafe-inline' 'self'",
				"script-src": "'self'",
				"frame-src": "https://www.youtube.com https://www.youtube-nocookie.com https://discord.com 'self'",
				"media-src": "https://*.githubusercontent.com"
			}
		}
	}
}
